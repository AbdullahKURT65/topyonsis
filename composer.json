{
  "name": "abdullahkurt65/topyonsis",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0",
    "spatie/laravel-permission": "^5.5",
    "barryvdh/laravel-dompdf": "^1.0",
    "maatwebsite/excel": "^3.1",
    "laravel/breeze": "^1.20"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  }
}
